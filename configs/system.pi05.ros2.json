{
  "devices": [
    {
      "name": "robot_1.arm",
      "robot_id": "robot_1",
      "backend": "ros2",
      "action_name": "/robot_1/follow_joint_trajectory",
      "joint_state_topic": "/robot_1/joint_states",
      "joint_names": [
        "joint_1",
        "joint_2",
        "joint_3",
        "joint_4",
        "joint_5",
        "joint_6",
        "joint_7"
      ],
      "limits": [
        [
          -2,
          2
        ],
        [
          -2,
          2
        ],
        [
          -2,
          2
        ],
        [
          -2,
          2
        ],
        [
          -2,
          2
        ],
        [
          -2,
          2
        ],
        [
          -2,
          2
        ]
      ],
      "camera_topics": {
        "front": "/robot_1/camera/image_raw",
        "wrist": "/robot_1/wrist/image_raw"
      }
    },
    {
      "name": "robot_1.hand",
      "robot_id": "robot_1",
      "backend": "ros2_gripper",
      "action_name": "/robot_1/gripper_command",
      "joint_state_topic": "/robot_1/joint_states",
      "joint_name": "gripper_joint"
    },
    {
      "name": "robot_2.arm",
      "robot_id": "robot_2",
      "backend": "ros2",
      "action_name": "/robot_2/follow_joint_trajectory",
      "joint_state_topic": "/robot_2/joint_states",
      "joint_names": [
        "joint_1",
        "joint_2",
        "joint_3",
        "joint_4",
        "joint_5",
        "joint_6",
        "joint_7"
      ],
      "limits": [
        [
          -2,
          2
        ],
        [
          -2,
          2
        ],
        [
          -2,
          2
        ],
        [
          -2,
          2
        ],
        [
          -2,
          2
        ],
        [
          -2,
          2
        ],
        [
          -2,
          2
        ]
      ],
      "camera_topics": {
        "front": "/robot_2/camera/image_raw",
        "wrist": "/robot_2/wrist/image_raw"
      }
    },
    {
      "name": "robot_2.hand",
      "robot_id": "robot_2",
      "backend": "ros2_gripper",
      "action_name": "/robot_2/gripper_command",
      "joint_state_topic": "/robot_2/joint_states",
      "joint_name": "gripper_joint"
    },
    {
      "name": "scene",
      "backend": "ros2_service",
      "service_name": "/robot_1/scan"
    }
  ],
  "groups": [
    {
      "name": "robot_1.control",
      "members": [
        "robot_1.arm.trajectory",
        "robot_1.hand.gripper"
      ]
    },
    {
      "name": "robot_2.control",
      "members": [
        "robot_2.arm.trajectory",
        "robot_2.hand.gripper"
      ]
    }
  ],
  "schema": "robot_runtime.config.v1",
  "models": {
    "gp6": {
      "kind": "openai_responses",
      "model": "gpt-6-astra",
      "endpoint_env": "GP6_ENDPOINT",
      "key_env": "GP6_API_KEY",
      "stream": true,
      "structured_output": false,
      "timeout_s": 60
    },
    "pi05": {
      "kind": "vla_json",
      "model": "pi05_droid",
      "endpoint_env": "PI05_BRIDGE_ENDPOINT",
      "key_env": "PI05_BRIDGE_TOKEN",
      "timeout_s": 60
    }
  },
  "planner": "gp6",
  "scheduler": {
    "max_parallel": 2,
    "max_replans": 1,
    "max_active_tasks": 8
  },
  "runtime": {
    "observation_ttl_s": 10,
    "cancel_timeout_s": 2
  }
}
